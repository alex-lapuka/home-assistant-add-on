#!/bin/sh
# ==============================================================================
# Twingate Gateway add-on: the Gateway, the add-on's main service.
#
# s6 connects standard output to the twingate-gateway-log service, s6-log.
# It is moved to file descriptor 3, where /run.sh passes it to the Gateway for
# its audit log. The messages of /run.sh and the Gateway's system log go to
# the add-on log directly, through standard error.
# ==============================================================================
exec 3>&1 1>&2
exec /run.sh
