#!/bin/sh
# ==============================================================================
# Stops the add-on when the Connector exits on its own, for example because an
# option is missing, the installation failed or Twingate rejected the
# Connector for good (exit code 78), with the Connector's exit code. This
# keeps the behaviour of the Connector as the container's main program: the
# add-on stops with it. When the add-on is being stopped, s6 has already
# marked the service as down and this script changes nothing.
#
# s6 passes the exit code, or 256 and the signal number when a signal ended
# the Connector.
# ==============================================================================
exit_code="${1}"
signal="${2}"

wanted_up=$(s6-svstat -o wantedup .) || wanted_up=""
if [ "${wanted_up}" != "true" ]; then
    exit 0
fi

if [ "${exit_code}" -eq 256 ]; then
    exit_code=$((128 + signal))
fi
echo "${exit_code}" >/run/s6-linux-init-container-results/exitcode
/run/s6/basedir/bin/halt

# Exit code 125 tells s6 not to start the Connector again.
exit 125
